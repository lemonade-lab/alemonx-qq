{
  "id": "alemonx-qq",
  "name": "QQ",
  "version": "0.0.1",
  "description": "管理 NapCat 与 LuckyLillia，连接到 AlemonJS OneBot。",
  "platforms": [
    "darwin",
    "linux",
    "windows"
  ],
  "runtime": "binary",
  "entry": {
    "darwin-arm64": "dist/alemonx-qq-darwin-arm64",
    "darwin-amd64": "dist/alemonx-qq-darwin-amd64",
    "linux-amd64": "dist/alemonx-qq-linux-amd64",
    "linux-arm64": "dist/alemonx-qq-linux-arm64",
    "windows-amd64": "dist/alemonx-qq-windows-amd64.exe"
  },
  "development": {
    "runtime": "go",
    "entry": {
      "go": "runner"
    },
    "web": {
      "mode": "dev-server",
      "root": "web",
      "build": {
        "program": "yarn",
        "args": [
          "--cwd",
          "frontend",
          "build"
        ]
      },
      "dev": {
        "program": "yarn",
        "args": [
          "--cwd",
          "frontend",
          "dev",
          "--host",
          "127.0.0.1",
          "--port",
          "${ALX_PLUGIN_DEV_PORT}"
        ]
      },
      "healthPath": "/",
      "hmr": true
    }
  },
  "web": {
    "root": "web"
  },
  "systemPickers": [
    {
      "id": "napcat-directory",
      "kind": "directory",
      "title": "选择现有 NapCat 安装目录"
    },
    {
      "id": "luckylillia-directory",
      "kind": "directory",
      "title": "选择 LuckyLillia CLI 解压目录"
    }
  ],
  "statusActions": [
    "status",
    "napcat-status",
    "luckylillia-status",
    "napcat-log-status",
    "napcat-operation-status",
    "luckylillia-log-status"
  ],
  "media": [
    {
      "id": "napcat-qrcode",
      "action": "napcat-qrcode",
      "contentType": "image/png"
    }
  ],
  "privilegedOperations": [
    {
      "action": "napcat-install-dependencies",
      "runnerAction": "napcat-install-dependencies",
      "title": "准备 QQ 登录运行环境",
      "description": "QQ 插件将安装本机图形登录所需的系统组件；密码只用于本次系统授权。",
      "authorization": "password",
      "platforms": [
        "linux"
      ],
      "commands": [
        {
          "program": "apt-get",
          "args": [
            "install",
            "-y",
            "xvfb",
            "x11-xkb-utils",
            "xkb-data",
            "libnss3",
            "libgbm1",
            "libglib2.0-0",
            "libatk1.0-0",
            "libatk-bridge2.0-0",
            "libatspi2.0-0",
            "libgtk-3-0",
            "libasound2",
            "libcups2",
            "libxcomposite1",
            "libxdamage1",
            "libxfixes3",
            "libxrandr2",
            "libxkbcommon0"
          ]
        },
        {
          "program": "dnf",
          "args": [
            "install",
            "--allowerasing",
            "-y",
            "xorg-x11-server-Xvfb",
            "xkbcomp",
            "xkeyboard-config",
            "nss",
            "mesa-libgbm",
            "glib2",
            "atk",
            "at-spi2-atk",
            "gtk3",
            "alsa-lib",
            "cups-libs",
            "libXcomposite",
            "libXdamage",
            "libXfixes",
            "libXrandr"
          ]
        }
      ]
    }
  ],
  "services": [
    {
      "id": "napcat-webui",
      "name": "NapCat WebUI",
      "host": "127.0.0.1",
      "port": 6099,
      "basePath": "/webui",
      "healthPath": "/",
      "embed": true,
      "rewriteHtml": true,
      "sse": true
    },
    {
      "id": "luckylillia-webui",
      "name": "LuckyLillia WebUI",
      "host": "127.0.0.1",
      "port": 3080,
      "basePath": "/",
      "healthPath": "/",
      "embed": true,
      "rewriteHtml": true,
      "sse": true
    }
  ],
  "navigation": {
    "label": "QQ",
    "icon": "qq",
    "order": -90
  }
}
