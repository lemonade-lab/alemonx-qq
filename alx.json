{
  "id": "alemonx-qq",
  "name": "QQ",
  "version": "0.0.1",
  "description": "管理 NapCat 与 LuckyLillia，连接到 AlemonJS OneBot。",
  "platforms": [
    "darwin",
    "linux",
    "windows"
  ],
  "runtime": "binary",
  "entry": {
    "darwin-arm64": "dist/alemonx-qq-darwin-arm64",
    "darwin-amd64": "dist/alemonx-qq-darwin-amd64",
    "linux-amd64": "dist/alemonx-qq-linux-amd64",
    "linux-arm64": "dist/alemonx-qq-linux-arm64",
    "windows-amd64": "dist/alemonx-qq-windows-amd64.exe"
  },
  "development": {
    "runtime": "go",
    "entry": {
      "go": "runner/main.go"
    }
  },
  "web": {
    "root": "web"
  },
  "services": [
    {
      "id": "napcat-webui",
      "name": "NapCat WebUI",
      "host": "127.0.0.1",
      "port": 6099,
      "basePath": "/webui",
      "healthPath": "/",
      "embed": true,
      "rewriteHtml": true,
      "sse": true
    },
    {
      "id": "luckylillia-webui",
      "name": "LuckyLillia WebUI",
      "host": "127.0.0.1",
      "port": 3080,
      "basePath": "/",
      "healthPath": "/",
      "embed": true,
      "rewriteHtml": true,
      "sse": true
    }
  ],
  "navigation": {
    "label": "QQ",
    "icon": "qq",
    "order": -90
  }
}
