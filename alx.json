{
  "id": "alemonx-qq",
  "name": "QQ",
  "version": "0.0.1",
  "description": "管理 NapCat 与 LuckyLillia，连接到 AlemonJS OneBot。",
  "platforms": [
    "darwin",
    "linux",
    "windows"
  ],
  "runtime": "binary",
  "entry": {
    "darwin-arm64": "dist/alemonx-qq-darwin-arm64",
    "darwin-amd64": "dist/alemonx-qq-darwin-amd64",
    "linux-amd64": "dist/alemonx-qq-linux-amd64",
    "linux-arm64": "dist/alemonx-qq-linux-arm64",
    "windows-amd64": "dist/alemonx-qq-windows-amd64.exe"
  },
  "development": {
    "runtime": "go",
    "entry": {
      "go": "runner"
    },
    "web": {
      "mode": "dev-server",
      "root": "web",
      "build": {
        "program": "yarn",
        "args": ["--cwd", "frontend", "build"]
      },
      "dev": {
        "program": "yarn",
        "args": ["--cwd", "frontend", "dev", "--host", "127.0.0.1", "--port", "${ALX_PLUGIN_DEV_PORT}"]
      },
      "healthPath": "/",
      "hmr": true
    }
  },
  "web": {
    "root": "web"
  },
  "systemPickers": [
    {
      "id": "napcat-directory",
      "kind": "directory",
      "title": "选择现有 NapCat 安装目录"
    },
    {
      "id": "luckylillia-directory",
      "kind": "directory",
      "title": "选择 LuckyLillia CLI 解压目录"
    }
  ],
  "hostCapabilities": [
    "finder",
    "robot-context",
    "network-context"
  ],
  "services": [
    {
      "id": "napcat-webui",
      "name": "NapCat WebUI",
      "host": "127.0.0.1",
      "port": 6099,
      "basePath": "/webui",
      "healthPath": "/",
      "embed": true,
      "rewriteHtml": true,
      "sse": true
    },
    {
      "id": "luckylillia-webui",
      "name": "LuckyLillia WebUI",
      "host": "127.0.0.1",
      "port": 3080,
      "basePath": "/",
      "healthPath": "/",
      "embed": true,
      "rewriteHtml": true,
      "sse": true
    }
  ],
  "navigation": {
    "label": "QQ",
    "icon": "qq",
    "order": -90
  }
}
